{
  "name": "presupuesta-mi-web",
  "version": "1.0.0",
  "description": "API REST que calcula presupuestos de proyectos web (Node.js + Express)",
  "main": "src/server.js",
  "scripts": {
    "start": "npm run dev",
    "dev": "concurrently -k \"npm run api\" \"npm --prefix frontend/presupuesta-mi-web run dev\"",
    "api": "node src/server.js",
    "build": "npm --prefix frontend/presupuesta-mi-web run build",
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "license": "ISC",
  "dependencies": {
    "concurrently": "^10.0.7",
    "dotenv": "^18.0.10",
    "express": "^4.19.2",
    "openai": "^4.104.0",
    "pdfkit": "^0.20.2"
  }
}
